<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
 xmlns:xsd="http://www.w3.org/2001/XMLSchema"
 xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
 xmlns:tns="https://api.labcompute.example/algorithms/v1"
 targetNamespace="https://api.labcompute.example/algorithms/v1"
 name="LabComputeAlgorithmService">
 <wsdl:documentation>
  Fictional external academic execution provider; not AlgoViz's Algorithm Service.
  Design-time WSDL 1.1, SOAP 1.1 document/literal contract.
  bubbleSortTrace sorts ascending; indices are zero-based. Each step contains
  the array state after the named action (compare leaves the state unchanged).
  Complexity values describe the in-place sorting algorithm, excluding trace storage.
 </wsdl:documentation>
 <wsdl:types>
  <xsd:schema targetNamespace="https://api.labcompute.example/algorithms/v1"
   elementFormDefault="qualified">
   <xsd:simpleType name="NonEmptyString">
    <xsd:restriction base="xsd:string"><xsd:minLength value="1"/></xsd:restriction>
   </xsd:simpleType>
   <xsd:complexType name="IntArray">
    <xsd:sequence><xsd:element name="item" type="xsd:int" minOccurs="2" maxOccurs="20"/></xsd:sequence>
   </xsd:complexType>
   <xsd:simpleType name="Action">
    <xsd:restriction base="xsd:string">
     <xsd:enumeration value="COMPARE"/><xsd:enumeration value="SWAP"/>
    </xsd:restriction>
   </xsd:simpleType>
   <xsd:complexType name="TraceStep">
    <xsd:sequence>
     <xsd:element name="stepNumber" type="xsd:positiveInteger"/>
     <xsd:element name="action" type="tns:Action"/>
     <xsd:element name="leftIndex" type="xsd:nonNegativeInteger"/>
     <xsd:element name="rightIndex" type="xsd:nonNegativeInteger"/>
     <xsd:element name="state" type="tns:IntArray"/>
    </xsd:sequence>
   </xsd:complexType>
   <xsd:element name="Credentials">
    <xsd:complexType><xsd:sequence>
     <xsd:element name="clientId" type="tns:NonEmptyString"/>
     <xsd:element name="apiKey" type="tns:NonEmptyString"/>
    </xsd:sequence>
    <xsd:anyAttribute namespace="http://schemas.xmlsoap.org/soap/envelope/" processContents="lax"/>
    </xsd:complexType>
   </xsd:element>
   <xsd:element name="BubbleSortRequest">
    <xsd:complexType><xsd:sequence>
     <xsd:element name="requestId" type="tns:NonEmptyString"/>
     <xsd:element name="values" type="tns:IntArray"/>
    </xsd:sequence></xsd:complexType>
   </xsd:element>
   <xsd:element name="BubbleSortResponse">
    <xsd:complexType><xsd:sequence>
     <xsd:element name="requestId" type="tns:NonEmptyString"/>
     <xsd:element name="sortedValues" type="tns:IntArray"/>
     <xsd:element name="steps"><xsd:complexType><xsd:sequence>
      <xsd:element name="step" type="tns:TraceStep" minOccurs="1" maxOccurs="unbounded"/>
     </xsd:sequence></xsd:complexType></xsd:element>
     <xsd:element name="timeComplexity" type="xsd:string" fixed="O(n^2) worst case"/>
     <xsd:element name="spaceComplexity" type="xsd:string" fixed="O(1) auxiliary, excluding trace"/>
    </xsd:sequence></xsd:complexType>
   </xsd:element>
   <xsd:element name="ExecutionFault">
    <xsd:complexType><xsd:sequence>
     <xsd:element name="requestId" type="tns:NonEmptyString"/>
     <xsd:element name="code" type="xsd:string" fixed="ENGINE_UNAVAILABLE"/>
     <xsd:element name="message" type="tns:NonEmptyString"/>
    </xsd:sequence></xsd:complexType>
   </xsd:element>
  </xsd:schema>
 </wsdl:types>
 <wsdl:message name="CredentialsMessage"><wsdl:part name="credentials" element="tns:Credentials"/></wsdl:message>
 <wsdl:message name="BubbleSortInput"><wsdl:part name="parameters" element="tns:BubbleSortRequest"/></wsdl:message>
 <wsdl:message name="BubbleSortOutput"><wsdl:part name="parameters" element="tns:BubbleSortResponse"/></wsdl:message>
 <wsdl:message name="ExecutionFaultMessage"><wsdl:part name="detail" element="tns:ExecutionFault"/></wsdl:message>
 <wsdl:portType name="AlgorithmPortType">
  <wsdl:operation name="bubbleSortTrace">
   <wsdl:input message="tns:BubbleSortInput"/>
   <wsdl:output message="tns:BubbleSortOutput"/>
   <wsdl:fault name="ExecutionFault" message="tns:ExecutionFaultMessage"/>
  </wsdl:operation>
 </wsdl:portType>
 <wsdl:binding name="AlgorithmSoapBinding" type="tns:AlgorithmPortType">
  <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
  <wsdl:operation name="bubbleSortTrace">
   <soap:operation soapAction="https://api.labcompute.example/algorithms/v1/bubbleSortTrace"/>
   <wsdl:input>
    <soap:header message="tns:CredentialsMessage" part="credentials" use="literal"/>
    <soap:body parts="parameters" use="literal"/>
   </wsdl:input>
   <wsdl:output><soap:body parts="parameters" use="literal"/></wsdl:output>
   <wsdl:fault name="ExecutionFault"><soap:fault name="ExecutionFault" use="literal"/></wsdl:fault>
  </wsdl:operation>
 </wsdl:binding>
 <wsdl:service name="LabComputeAlgorithmService">
  <wsdl:port name="AlgorithmSoapPort" binding="tns:AlgorithmSoapBinding">
   <soap:address location="https://api.labcompute.example/soap/v1/AlgorithmService"/>
  </wsdl:port>
 </wsdl:service>
</wsdl:definitions>
